# ============================================================
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交
# ============================================================

# ---------- 数据库 ----------
# sqlite：零依赖离线演示（默认） | postgres：正式路径，走视图/触发器/存储过程
DB_MODE=sqlite
SQLITE_PATH=data/finance.db

# DB_MODE=postgres 时必填
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SCHEMA=public

# 课设为单用户场景，默认用户 ID
DEFAULT_USER_ID=1

# ---------- AI（不填 Key 也能运行，会自动降级为规则模式） ----------
AI_ENABLED=true
DEEPSEEK_API_KEY=
CHAT_API_BASE=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
CHAT_TIMEOUT=60

# AI 写操作（记账/转账/预算）是否需要用户二次确认
REQUIRE_WRITE_CONFIRMATION=true

# ---------- 知识库检索 ----------
# bm25：内置词法检索，零依赖（默认）
# local：本地向量模型，需要 pip install -r requirements-rag.txt 并首次下载模型
EMBEDDING_PROVIDER=bm25
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=models/embeddings
RETRIEVAL_LIMIT=5
